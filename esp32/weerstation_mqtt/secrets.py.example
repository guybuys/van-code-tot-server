# Kopieer dit bestand naar secrets.py en vul de waarden in.
# secrets.py staat in .gitignore en gaat niet naar GitHub.

WIFI_SSID = "JOUW_WIFI"
WIFI_WACHTWOORD = "JOUW_WIFI_WACHTWOORD"

# IP-adres van de EMQX-broker. Poort 1883 is MQTT zonder TLS.
MQTT_BROKER = "192.168.1.10"
MQTT_POORT = 1883
MQTT_GEBRUIKER = "GEBRUIKER"
MQTT_WACHTWOORD = "WACHTWOORD"

# Elk bord krijgt een eigen client-id en een eigen topic.
MQTT_CLIENT_ID = "esp32-1"
MQTT_TOPIC = "weerstation/1/meting"
